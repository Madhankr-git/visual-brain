# Visual Brain — Client Environment Variables
# Dedicated Supabase project exclusively for Visual Brain
# Copy this file to .env.local for local development.
# Retrieve these values from your Supabase Dashboard: Project Settings -> API

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Note: Never place SUPABASE_SERVICE_ROLE_KEY or database passwords in this file.
